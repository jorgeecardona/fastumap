#!/bin/sh
# Bump the project version in pyproject.toml -- the single source of truth hatchling
# builds from. Usage: ./scripts/bump-version [patch|minor|major]   (default: patch)
set -e
cd "$(dirname "$0")/.."

BUMP_TYPE="${1:-patch}"

CURRENT=$(grep -E '^version = "' pyproject.toml | head -1 | sed -E 's/^version = "(.*)"/\1/')
if [ -z "$CURRENT" ]; then
    echo "bump-version: could not read 'version = \"...\"' from pyproject.toml" >&2
    exit 1
fi

MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
PATCH=$(echo "$CURRENT" | cut -d. -f3)

case "$BUMP_TYPE" in
    major) MAJOR=$((MAJOR + 1)); MINOR=0; PATCH=0 ;;
    minor) MINOR=$((MINOR + 1)); PATCH=0 ;;
    patch) PATCH=$((PATCH + 1)) ;;
    *) echo "Usage: $0 [patch|minor|major]" >&2; exit 1 ;;
esac

NEW="${MAJOR}.${MINOR}.${PATCH}"
# Write through a temp file rather than `sed -i`: GNU takes `-i` with no suffix, but BSD/macOS
# sed reads the next token as the backup suffix, so `sed -i -E ...` there leaves a stray
# pyproject.toml-E file. `sed -E > tmp && mv` behaves the same on both.
TMP=$(mktemp)
sed -E "s/^version = \"${CURRENT}\"/version = \"${NEW}\"/" pyproject.toml > "$TMP"
mv "$TMP" pyproject.toml

# Keep uv.lock's pinned fastumap version in sync with pyproject so the working tree stays
# clean after a bump (offline + cached = fast; online fallback for a cold cache).
if command -v uv >/dev/null 2>&1; then
    uv lock --offline >/dev/null 2>&1 || uv lock >/dev/null 2>&1 || true
fi

echo "bump-version: ${CURRENT} -> ${NEW}"
