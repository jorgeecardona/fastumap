#!/bin/sh
# Release driver, invoked by the `release` moon task (deps `ci`) which the CI job runs
# on the default branch when PYPI_READY=1. Idempotent:
#   - if this version's sdist is already on PyPI -> no-op
#   - else publish dist/* to PyPI via OIDC (scripts/pypi-publish), skipping files already there
# It checks the sdist, not the version: wheels-macos and wheels-windows publish to the same
# version on their own, and the macOS job can finish first. A version check then skipped the
# Linux wheels and the sdist (0.2.33).
set -e
cd "$(CDPATH= cd "$(dirname "$0")/.." && pwd)"

V="$(grep -E '^version = "' pyproject.toml | head -1 | cut -d'"' -f2)"
[ -n "$V" ] || { echo "release: could not read version from pyproject.toml" >&2; exit 1; }

if uv run python - "$V" <<'PY'
import json, sys, urllib.request
version = sys.argv[1]
try:
    data = json.load(urllib.request.urlopen("https://pypi.org/pypi/fastumap/json"))
    files = data["releases"].get(version, [])
    sdist = f"fastumap-{version}.tar.gz"
    sys.exit(0 if any(f["filename"] == sdist for f in files) else 1)
except Exception:
    sys.exit(1)
PY
then
    echo "release: fastumap $V sdist already on PyPI -- nothing to do"
    exit 0
fi

echo "release: publishing fastumap $V to PyPI"
sh scripts/pypi-publish
